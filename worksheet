<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Syllabus Quest: Uno Edition (Interactive)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Poppins:wght@400;600;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f1f5f9;
            color: #1a1a1a;
            -webkit-print-color-adjust: exact;
        }
        .uno-font {
            font-family: 'Luckiest+Guy', cursive;
            letter-spacing: 0.05em;
        }
        .page {
            background: #ffffff;
            width: 8.5in;
            min-height: 11in;
            padding: 0.4in;
            margin: 1rem auto;
            position: relative;
            border: 4px solid #000000;
            border-radius: 40px;
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
        }
        
        /* Interactive Input Styling */
        input[type="text"], textarea {
            border: none;
            border-bottom: 2px solid #cbd5e1;
            background: transparent;
            width: 100%;
            padding: 2px 4px;
            /* Font size aligned with question labels */
            font-size: 0.75rem; 
            font-weight: 600;
            color: #1e40af;
            transition: border-color 0.2s;
        }
        input[type="text"]:focus, textarea:focus {
            outline: none;
            border-bottom-color: #000;
            background: #f8fafc;
        }
        textarea {
            resize: none;
            line-height: 1.8rem;
            background-image: linear-gradient(transparent 95%, #cbd5e1 5%);
            background-size: 100% 1.8rem;
            border-bottom: none;
            font-size: 0.875rem;
        }

        /* Card Borders */
        .card-red { border: 4px solid #d91e18; }
        .card-blue { border: 4px solid #1e40af; }
        .card-yellow { border: 4px solid #b45309; } 
        .card-green { border: 4px solid #15803d; }

        /* Print Logic */
        @media print {
            body { background-color: white; padding: 0; margin: 0; }
            .page { 
                margin: 0; 
                border-radius: 0; 
                box-shadow: none;
                width: 100%;
                border-width: 2px;
            }
            .no-print { display: none !important; }
            input[type="text"]::placeholder, textarea::placeholder {
                color: transparent;
            }
        }

        .instruction-bar {
            max-width: 8.5in;
            margin: 1rem auto;
            background: #1e293b;
            color: white;
            padding: 1rem;
            border-radius: 12px;
            font-size: 0.85rem;
        }
    </style>
</head>
<body class="p-4">

    <!-- Explicit Instructions for Students -->
    <div class="instruction-bar no-print flex items-center gap-4">
        <div class="bg-blue-600 p-2 rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
        </div>
        <div>
            <p class="font-bold">How to Save Your Work:</p>
            <p class="opacity-90">1. Fill out the fields below. 2. Press <kbd class="bg-slate-700 px-1 rounded text-xs">Ctrl + P</kbd> (Windows) or <kbd class="bg-slate-700 px-1 rounded text-xs">Cmd + P</kbd> (Mac). 3. Change "Destination" to <b>Save as PDF</b>.</p>
        </div>
    </div>

    <div class="page">
        <!-- Header Area -->
        <div class="flex justify-between items-center mb-6">
            <div class="bg-black text-white px-8 py-3 rounded-2xl transform -rotate-1">
                <h1 class="uno-font text-4xl italic tracking-widest uppercase">SYLLABUS QUEST</h1>
                <p class="text-xs font-bold tracking-tight uppercase">Careers & Prof Dev: BUSI 1200</p>
            </div>
            <div class="text-right">
                <div class="font-bold text-lg flex items-center justify-end gap-2">
                    DATE: <input type="text" class="w-32 text-center" placeholder="MM/DD/YY">
                </div>
            </div>
        </div>

        <!-- DRAW TWO: Team Info -->
        <div class="bg-white card-blue rounded-3xl p-4 mb-6">
            <div class="flex items-center gap-4 mb-2">
                <div class="bg-blue-800 text-white w-10 h-10 rounded-full flex items-center justify-center uno-font text-xl">+2</div>
                <h2 class="uno-font text-xl text-blue-800 uppercase">ADD GROUP MEMBER NAMES</h2>
            </div>
            <div class="grid grid-cols-3 gap-x-6 gap-y-3">
                <div class="flex gap-1 items-center font-bold text-xs text-slate-400">1. <input type="text" placeholder="Full Name"></div>
                <div class="flex gap-1 items-center font-bold text-xs text-slate-400">2. <input type="text" placeholder="Full Name"></div>
                <div class="flex gap-1 items-center font-bold text-xs text-slate-400">3. <input type="text" placeholder="Full Name"></div>
                <div class="flex gap-1 items-center font-bold text-xs text-slate-400">4. <input type="text" placeholder="Full Name"></div>
                <div class="flex gap-1 items-center font-bold text-xs text-slate-400">5. <input type="text" placeholder="Full Name"></div>
                <div class="flex gap-1 items-center font-bold text-xs text-slate-400">6. <input type="text" placeholder="Full Name"></div>
            </div>
        </div>

        <!-- The Main Deck -->
        <div class="grid grid-cols-2 gap-6 mb-6">
            <div class="bg-white card-red rounded-3xl p-5">
                <div class="flex items-center gap-2 mb-4">
                    <span class="uno-font text-3xl text-red-600 italic">Ø</span>
                    <h3 class="uno-font text-xl text-red-600 uppercase">SKIP THE GUESSWORK</h3>
                </div>
                <div class="space-y-5">
                    <div>
                        <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Professor Phone Number</p>
                        <input type="text" placeholder="Type here...">
                    </div>
                    <div>
                        <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Which assignment is 20% of grade?</p>
                        <input type="text" placeholder="Type here...">
                    </div>
                    <div>
                        <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Penalty for being 5 mins late?</p>
                        <input type="text" placeholder="Type here...">
                    </div>
                </div>
            </div>

            <div class="bg-white card-green rounded-3xl p-5">
                <div class="flex items-center gap-2 mb-4">
                    <span class="uno-font text-3xl text-green-700">⟳</span>
                    <h3 class="uno-font text-xl text-green-700 uppercase">REVERSE SEARCH</h3>
                </div>
                <div class="space-y-5">
                    <div>
                        <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Name of attendance log tool</p>
                        <input type="text" placeholder="Type here...">
                    </div>
                    <div>
                        <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Group Advising Session date</p>
                        <input type="text" placeholder="Type here...">
                    </div>
                    <div>
                        <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Two specific events on Feb 11th</p>
                        <input type="text" placeholder="Type here...">
                    </div>
                </div>
            </div>
        </div>

        <!-- Yellow Section -->
        <div class="bg-white card-yellow rounded-3xl p-5 mb-6">
            <h3 class="uno-font text-amber-700 mb-4 text-center text-2xl uppercase">WILD CARD CHALLENGE</h3>
            <div class="grid grid-cols-2 gap-x-10 gap-y-5">
                <div>
                    <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">List the 2 Asynchronous Class dates</p>
                    <input type="text" placeholder="Type here...">
                </div>
                <div>
                    <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Last day to submit late work?</p>
                    <input type="text" placeholder="Type here...">
                </div>
                <div>
                    <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">AI Policy: Name one "prohibited" use</p>
                    <input type="text" placeholder="Type here...">
                </div>
                <div>
                    <p class="font-bold text-[10px] text-slate-500 uppercase mb-1">Where is the Fire Assembly Area?</p>
                    <input type="text" placeholder="Type here...">
                </div>
            </div>
        </div>

        <!-- Strategy Area -->
        <div class="border-4 border-black rounded-3xl p-6 bg-white">
            <div class="flex items-center gap-4 mb-3">
                <div class="grid grid-cols-2 gap-1 w-8">
                    <div class="w-3 h-3 bg-red-600 rounded-sm"></div>
                    <div class="w-3 h-3 bg-blue-700 rounded-sm"></div>
                    <div class="w-3 h-3 bg-amber-600 rounded-sm"></div>
                    <div class="w-3 h-3 bg-green-700 rounded-sm"></div>
                </div>
                <h2 class="uno-font text-2xl italic tracking-wider text-black uppercase">TEAM STRATEGY: SHOUT "UNO!"</h2>
            </div>
            <p class="font-bold text-[10px] mb-2 text-slate-800 uppercase">Discuss: Which policy surprised you? What is your strategy to stay on track this semester?</p>
            <textarea rows="5" placeholder="Click here to type your team strategy..."></textarea>
        </div>

        <!-- Roadmap Link Footer -->
        <div class="mt-8 pt-4 border-t-2 border-slate-200 flex flex-col items-center">
            <p class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Access the Career Roadmap Hunt here:</p>
            <div class="bg-slate-50 px-4 py-1.5 rounded-lg border border-slate-200">
                <code class="text-blue-800 font-bold text-xs">https://jamilahkangudja.github.io/career-roadmap/hunt.html</code>
            </div>
        </div>
    </div>

</body>
</html>
